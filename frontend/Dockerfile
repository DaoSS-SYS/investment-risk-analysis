# Образ клиентской части.
#
# Как и для серверной части, сборка выполняется в два этапа. Среда
# выполнения приложению не требуется вовсе: результатом сборки являются
# файлы разметки, стилей и сценариев, которые отдаёт обычный сервер
# статических файлов. Ни Node.js, ни исходный код в итоговый образ
# не попадают.

# ---------------------------------------------------------------------------
# Этап сборки
# ---------------------------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /src

# Перечень зависимостей копируется прежде исходного кода — по той же
# причине, что и в образе серверной части: чтобы изменение кода
# не приводило к повторной загрузке пакетов.
#
# Применяется npm ci, а не npm install: эта команда устанавливает версии
# строго по npm-package-lock.json и не изменяет его. Сборка образа
# воспроизводима — при повторной сборке будут установлены те же версии.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

RUN npm run build

# ---------------------------------------------------------------------------
# Этап отдачи файлов
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80

# Сервер запускается без перехода в фоновый режим: управление временем
# жизни контейнера возлагается на средство запуска контейнеров, которое
# отслеживает основной процесс.
CMD ["nginx", "-g", "daemon off;"]
