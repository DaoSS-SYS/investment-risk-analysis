{
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "RiskAnalysis",
    "Audience": "RiskAnalysis",
    "SigningKey": "",
    "LifetimeHours": 12
  },
  "MoexIss": {
    "BaseUrl": "https://iss.moex.com/iss/",
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "RetryDelayMs": 1000,
    "PageDelayMs": 100
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
