# Образец файла параметров развёртывания.
#
# Порядок применения: скопировать в файл .env, задать собственные
# значения. Файл .env в репозиторий не включается (указан в .gitignore),
# поскольку содержит пароли и ключ подписи.
#
#     cp .env.example .env
#
# Значений по умолчанию для паролей и ключа подписи не предусмотрено
# намеренно: при их отсутствии составление прекращается с сообщением
# о том, какой параметр не задан. Значение по умолчанию, пригодное
# для запуска, с высокой вероятностью осталось бы неизменным.

# --- База данных ---------------------------------------------------------
POSTGRES_DB=riskanalysis
POSTGRES_USER=riskanalysis
POSTGRES_PASSWORD=

# Порт, на котором база данных доступна с машины развёртывания —
# для подключения средствами администрирования. Выбран 5433: на порту
# 5432 обычно уже выполняется локальный экземпляр СУБД.
DATABASE_PORT=5433

# --- Маркеры доступа -----------------------------------------------------
# Ключ подписи. Длина — не менее 32 знаков, иначе приложение не запустится.
# Пример получения случайного значения:
#     openssl rand -base64 48
JWT_SIGNING_KEY=

# Срок действия маркера, ч.
JWT_LIFETIME_HOURS=12

# --- Учётная запись администратора ---------------------------------------
# Пароль учётной записи admin, создаваемой при первом запуске.
# Требования: не менее восьми знаков, строчные и прописные буквы, цифры.
ADMIN_PASSWORD=

# --- Приложение ----------------------------------------------------------
# Порт, на котором открывается приложение: http://localhost:8080
APP_PORT=8080

# Доступность документации программного интерфейса по адресу /swagger.
# Включена для показа системы; при промышленном размещении — false.
SWAGGER_ENABLED=true
